# Zero-cost local operation
# true = avoid paid providers. Allows template, Ollama, LM Studio, local OpenAI-compatible, Groq free tier, and Gemini free tier.
ZERO_COST_MODE=true

# Local AI configuration
# template = no model required, creates a deterministic personalized draft at zero cost
# ollama = local Ollama server, usually http://localhost:11434
# lmstudio = local LM Studio server, usually http://localhost:1234/v1
# openai_compatible = local LM Studio/vLLM/LocalAI endpoint
# groq = Groq free plan API key
# gemini = Google Gemini API free tier key
# If a local model is unavailable, fall back to template instead of failing or spending money.
AI_PROVIDER=template
AI_FALLBACK_TO_TEMPLATE=true
AI_REQUEST_TIMEOUT_SECONDS=600
GENERATION_WORKERS=3
GENERATION_RECOVERY_MAX_AGE_MINUTES=120
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=local-model
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=local-model
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# SMTP defaults. Use an existing mailbox/free SMTP provider, or skip SMTP and create .eml drafts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DeepMail Studio
SMTP_SECURITY=starttls

# Sender profile used by AI generation and signatures. UI values override these.
SENDER_NAME=DeepMail Studio
SENDER_EMAIL=
SENDER_TITLE=
SENDER_ORGANIZATION=
SENDER_PHONE=
SENDER_WEBSITE=
SENDER_SIGNATURE_HTML=
